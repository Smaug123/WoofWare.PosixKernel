<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 rather than the library's net8.0: the Nix devshell carries only the
         net10 runtime, so a net8.0 test host has nothing to run on. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- NUnit runs a test per core, and the property tests allocate heavily. Under workstation
         GC each blocking collection suspends every test while one thread collects; server GC
         collects on every core. On a four-core Linux VM it took the suite from 658s to 401s. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

