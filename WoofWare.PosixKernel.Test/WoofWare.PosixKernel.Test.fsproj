  <ItemGroup>
    <!-- What `socket(2)` answered for raw arguments, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/socket-arguments.c.
         `TestSocketSyscall` holds `UnixSocket.socket` to it. -->
    <EmbeddedResource Include="socketSyscall\*.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- The order a thread took its pending signals in, and which thread took a
         signal sent to the process, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/signal-pick-order.c and
         signal-receiver.c. `TestSignalPickOrder` and `TestSignalReceiver` hold
         `SignalState` to them. -->
    <EmbeddedResource Include="signalOrder\*.txt" />
    <EmbeddedResource Include="signalReceiver\*.txt" />
    <!-- What a signal sent to the process, which every thread blocked, did
         once a thread unblocked it, measured per flavour by
         docs/probes/non-leader-unblock. `TestSignalReceiver` replays every row. -->
    <EmbeddedResource Include="..\docs\probes\non-leader-unblock\measured-linux-6.18.5-aarch64-uid0.txt" LogicalName="WoofWare.PosixKernel.Test.non-leader-unblock.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\non-leader-unblock\measured-darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.non-leader-unblock.darwin.txt" />
    <!-- docs/probes/disposition-before-return. `TestDispositionBeforeReturn` replays every held row. -->
    <EmbeddedResource Include="..\docs\probes\disposition-before-return\measured-linux-6.18.5-aarch64-uid0.txt" LogicalName="WoofWare.PosixKernel.Test.disposition-before-return.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\disposition-before-return\measured-darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.disposition-before-return.darwin.txt" />
    <!-- docs/probes/poll-entry-count. `TestPollEntryCount` replays every row. -->
    <EmbeddedResource Include="..\docs\probes\poll-entry-count\measured-linux-6.18.5-aarch64-uid0.txt" LogicalName="WoofWare.PosixKernel.Test.poll-entry-count.linux-aarch64-uid0.txt" />
    <EmbeddedResource Include="..\docs\probes\poll-entry-count\measured-linux-6.18.5-aarch64-uid1000.txt" LogicalName="WoofWare.PosixKernel.Test.poll-entry-count.linux-aarch64-uid1000.txt" />
    <EmbeddedResource Include="..\docs\probes\poll-entry-count\measured-linux-6.12.113-x86_64-uid0-qemu.txt" LogicalName="WoofWare.PosixKernel.Test.poll-entry-count.linux-x86_64-uid0.txt" />
    <EmbeddedResource Include="..\docs\probes\poll-entry-count\measured-darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.poll-entry-count.darwin-uid501.txt" />
    <!-- docs/probes/futex. `TestFutex` replays its screen and count rows. -->
    <EmbeddedResource Include="..\docs\probes\futex\measured-linux-6.18.5-aarch64-uid0.txt" LogicalName="WoofWare.PosixKernel.Test.futex.linux.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `epoll_ctl(2)` answered for every cell of the probe's ladder,
         measured on Linux; `TestEpollCtl` holds `UnixPoll.epollCtl` to it. -->
    <EmbeddedResource Include="epollCtl\linux-ladder.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What Linux 6.18.5 answered of inotify, measured by the probes in
         docs/plans/2026-10-11-inotify. `TestInotifyMeasured` replays them. -->
    <EmbeddedResource Include="..\docs\plans\2026-10-11-inotify\inotify-probe.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.inotify.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-10-11-inotify\inotify-instance-probe.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.inotifyInstance.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-10-11-inotify\inotify-descriptor-probe.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.inotifyDescriptor.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-10-11-inotify\inotify-delivery-probe.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.inotifyDelivery.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-10-11-inotify\inotify-dentry-probe.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.inotifyDentry.linux.txt" />
    <EmbeddedResource Include="..\docs\plans\2026-10-11-inotify\inotify-self-probe.linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.inotifySelf.linux.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- What a pipe or TCP transfer asleep when its description was made
         non-blocking answered to a signal, measured per flavour by
         docs/probes/nonblocking-asleep. `TestNonBlockingAsleepMeasured`
         replays every row. -->
    <EmbeddedResource Include="..\docs\probes\nonblocking-asleep\measured-linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.nonblocking-asleep.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\nonblocking-asleep\measured-darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.nonblocking-asleep.darwin.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package's README, which `TestReadme` holds to the library: every name
         it gives resolves, every signature it shows is the function's, and every
         code block runs and prints what the README says it prints. -->
    <EmbeddedResource Include="..\WoofWare.PosixKernel\README.md" LogicalName="WoofWare.PosixKernel.Test.README.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- What `setresuid(2)`, `setresgid(2)`, `setgroups(2)`, `getresuid(2)` and
         `getresgid(2)` answered, measured per flavour by
         docs/plans/2026-08-23-posix-kernel-extraction/setresid.c and embedded
         from beside it. `TestCredentialChange` replays every row. -->
    <!-- connect(2)'s answers for a sockaddr's family and length, measured by
         sockaddr-decoding.c, sockaddr-connect-ladder.c, sockaddr-bind-ladder.c and
         sockaddr-dgram-connect.c, embedded from beside them.
         `TestConnectLadderMeasured`, `TestBindLadderMeasured` and
         `TestConnectDestinationMeasured` replay every row. -->
    <!-- What connect(2) answered when its source was its own destination, measured
         per flavour by docs/probes/implicit-self-connect.
         `TestImplicitSelfConnectMeasured` replays every row. -->
    <EmbeddedResource Include="..\docs\probes\implicit-self-connect\measured-linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.implicit-self-connect.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\implicit-self-connect\measured-darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.implicit-self-connect.darwin.txt" />
    <!-- What a refused TCP connect left its socket holding, and what the socket's
         next bind(2), listen(2) and connect(2) answered, measured per flavour by
         docs/probes/refused-connect-port. `TestRefusedConnectPortMeasured`
         replays every row. -->
    <EmbeddedResource Include="..\docs\probes\refused-connect-port\measured-linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.refused-connect-port.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\refused-connect-port\measured-darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.refused-connect-port.darwin.txt" />
    <!-- Which ports a TCP socket's ephemeral search passed over, and what bind(2),
         listen(2) and connect(2) answered when it found none, measured per
         flavour by docs/probes/ephemeral-search. `TestEphemeralSearchMeasured`
         replays every row. -->
    <EmbeddedResource Include="..\docs\probes\ephemeral-search\measured-linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.ephemeral-search.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\ephemeral-search\measured-darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.ephemeral-search.darwin.txt" />
    <!-- Which ports a TCP connect's implicit bind passed over, for each kind of
         thing that held a port, measured per flavour by
         docs/probes/connect-search-holders. `TestConnectSearchHoldersMeasured`
         replays every row. -->
    <EmbeddedResource Include="..\docs\probes\connect-search-holders\measured-linux-6.18.5-aarch64.txt" LogicalName="WoofWare.PosixKernel.Test.connect-search-holders.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\connect-search-holders\measured-darwin-27.0.txt" LogicalName="WoofWare.PosixKernel.Test.connect-search-holders.darwin.txt" />
    <!-- Which binds two processes' sockets shared a port through, by
         SO_REUSEADDR and SO_REUSEPORT, and which ports a datagram socket's
         search took beside them, measured per flavour by
         docs/probes/port-sharing. `TestPortSharingMeasured` replays every row
         the model can make. -->
    <EmbeddedResource Include="..\docs\probes\port-sharing\measured-linux-6.18.5-aarch64-uid0.txt" LogicalName="WoofWare.PosixKernel.Test.port-sharing.linux.txt" />
    <EmbeddedResource Include="..\docs\probes\port-sharing\measured-darwin-27.0-uid501.txt" LogicalName="WoofWare.PosixKernel.Test.port-sharing.darwin.txt" />
    <!-- What a TCP TIME_WAIT held once both its sockets had closed, and when a
         connect took its four-tuple over, measured per flavour by
         docs/probes/time-wait. `TestTimeWaitMeasured` replays every row. -->
