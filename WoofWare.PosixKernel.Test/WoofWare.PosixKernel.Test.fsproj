  <ItemGroup>
    <!-- The socket/epoll differential fuzzer's C interpreter, and the corpus of
         transcripts it has measured against a real Linux kernel. Logical
         resource names follow the assembly, so `TestSocketFuzz` reads these as
         `WoofWare.PosixKernel.Test.socketFuzz*`. -->
    <EmbeddedResource Include="socketFuzz\harness.c" />
    <EmbeddedResource Include="signalFuzz\harness.c" />
    <EmbeddedResource Include="signalFuzzCorpus\*.txt" />
    <EmbeddedResource Include="multiProcessOracle\*.txt" />
    <EmbeddedResource Include="socketFuzzCorpus\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WoofWare.PosixKernel/WoofWare.PosixKernel.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound the test host's GC heap, so that a runaway property test fails with an
         OutOfMemoryException rather than taking the machine's memory. Absolute rather than a
         fraction of the machine's, so that several test hosts running at once stay bounded too.
         Decimal, 8 GiB: runtimeconfig properties are parsed with base 0. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="8589934592" />
    <!-- Server GC divides the limit above among its heaps, one per core unless told otherwise,
         and an object must fit in one heap's share: on an 18-core machine the 2 GiB buffers of
         the LargeMemory fixtures, and TestPipeBuffer's huge write, ran out of memory. Two heaps
         give each 4 GiB on every machine, and were as fast as one per core on a four-core VM. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.4.0"/>
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0"/>
    <PackageReference Include="FsUnit" Version="7.1.1"/>
    <PackageReference Include="FsCheck" Version="3.3.2" />
    <PackageReference Include="FsCheck.NUnit" Version="3.3.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
    <PackageReference Include="ApiSurface" Version="5.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApiSurface reaches System.Formats.Asn1 6.0.0 through NuGet.Packaging's dependency on
         System.Security.Cryptography.Pkcs 6.0.4. The shared framework carries a newer
         System.Formats.Asn1, which wins at run time, so the package's copy is never deployed. A
         stock .NET 10 SDK prunes the package from the graph for that reason, but the Nix-packaged
         SDK lacks the prune data (see AllowMissingPrunePackageData in Directory.Build.props), so
         NuGet audits it instead. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-447r-wph3-92pm" />
  </ItemGroup>

</Project>
