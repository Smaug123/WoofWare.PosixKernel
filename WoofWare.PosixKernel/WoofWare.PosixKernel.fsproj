<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>WoofWare.PosixKernel</PackageId>
    <Authors>Patrick Stevens</Authors>
    <Copyright>Copyright (c) Patrick Stevens 2026</Copyright>
    <Description>A deterministic, purely functional simulation of a POSIX process: filesystem, file descriptors, sockets, signals, and the Unix platform profile. No I/O and no host reads, so a replay never depends on the machine that produced it. From 1.0, a new case in any union whose cases are public is a major version. A call the model does not cover throws UnmodelledException, and a minor version may add or remove the places that do.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Smaug123/WoofWare.PosixKernel</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>light.png</PackageIcon>
    <PackageTags>posix;unix;simulation;deterministic;filesystem;sockets;fsharp;woofware</PackageTags>
    <!-- An unoptimised build otherwise calls a public copy of each `inline` function it uses,
         such as `<sumBy>__debug@261` for a `List.sumBy`, so a Debug assembly's public API
         would differ from a Release one's and no SurfaceBaseline.txt could match both.
         An optimised build inlines them anyway, so this changes nothing in Release. -->
    <OtherFlags>$(OtherFlags) --always-inline+</OtherFlags>
  </PropertyGroup>

